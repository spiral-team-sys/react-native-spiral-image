#!/bin/bash
set -e

echo "Cleaning..."

rm -rf node_modules
rm -rf lib
rm -rf dist
rm -rf nitrogen/generated

rm -rf android/.gradle
rm -rf android/build
rm -rf android/.cxx

rm -rf ios/build
rm -rf ios/Pods
rm -f ios/Podfile.lock

echo "Installing..."

npm install

echo "Generating Nitro..."

npx nitro-codegen

echo "Android clean..."

cd android
./gradlew clean
cd ..

echo "iOS Pods..."

cd ios
pod install
cd ..

echo "Done."